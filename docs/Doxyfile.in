PROJECT_NAME           = "ML Laboratory Project"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs"
INPUT                  = "@CMAKE_SOURCE_DIR@/src"
FILE_PATTERNS          = *.hpp *.h *.cpp
RECURSIVE              = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

EXTRACT_ALL            = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = NO
